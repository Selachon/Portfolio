{
  "name": "kora-portal-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "migrate:pglite": "node --env-file-if-exists=.env scripts/migrar-pglite-mongodb.js",
    "test": "node --test --test-concurrency=1 'test/*.test.js'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.2.1",
    "mongodb": "^6.21.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "mongodb-memory-server": "^10.4.3"
  }
}
