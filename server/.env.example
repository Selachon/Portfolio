# Copia este archivo a .env para desarrollo local. NUNCA guardes valores reales
# en Git.

MONGODB_URI=mongodb+srv://usuario:clave@cluster.example.mongodb.net/?appName=Kora
MONGODB_DATABASE=kora

PORT=8787
PUBLIC_ORIGIN=http://localhost:8787

# En local no hay HTTPS, así que la cookie Secure se desactiva.
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME_DAYS=14

# Coste del hash de contraseñas (2^N). 16 en producción; 12 acelera pruebas.
PASSWORD_COST_LOG2=16

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Solo se usan si la base está vacía. La contraseña queda marcada como temporal.
BOOTSTRAP_OWNER_EMAIL=tu-correo@ejemplo.com
BOOTSTRAP_OWNER_PASSWORD=cambia-esta-clave-2026
BOOTSTRAP_OWNER_NAME=Tu nombre

MAX_UPLOAD_BYTES=15728640

# Secreto independiente que autentica al colector de Proxmox. Genéralo con
# `openssl rand -hex 32`; no reutilices aquí el token de la API de Proxmox.
PROXMOX_INGEST_TOKEN=reemplazar-con-64-caracteres-hexadecimales
PROXMOX_STALE_AFTER_SECONDS=120
PROXMOX_RAW_RETENTION_DAYS=7
PROXMOX_ROLLUP_RETENTION_DAYS=31
PROXMOX_HISTORY_RETENTION_DAYS=400
